datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// World (shell) models. Owned by the world shell, see docs/apps.md.
// ============================================================================

model User {
  id         Int         @id @default(autoincrement())
  apps       UserApp[]
  // App relations
  portfolios   Portfolio[]
  arcadePlayer ArcadePlayer?
  arcadeGames  ArcadeGame[]
  gameRuns     GameRun[]
}

// Which apps a user has added to their world.
// Removing an app deletes this row only; the app's own data is kept.
model UserApp {
  id       Int      @id @default(autoincrement())
  appId    String   // matches AppManifest.id, e.g. "portfolio"
  position Int      @default(0)
  addedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int

  @@unique([userId, appId])
}

// ============================================================================
// Portfolio app models. Owned by the Portfolio app, see docs/apps.md.
// ============================================================================

model Portfolio {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  // Demo cash: every portfolio starts with virtual money to invest.
  startingCash Decimal   @default(100000) @db.Decimal(20, 4)
  cash         Decimal   @default(100000) @db.Decimal(20, 4)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int

  holdings     Holding[]
  trades       Trade[]

  @@index([userId])
}

// What a portfolio currently owns of one asset. `symbol` refers to the market
// catalog (src/apps/portfolio/market/catalog.ts). Average-cost accounting:
// costBasis is the total paid for the units still held.
model Holding {
  id          Int       @id @default(autoincrement())
  symbol      String
  quantity    Decimal   @db.Decimal(20, 8)
  costBasis   Decimal   @db.Decimal(20, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId Int

  @@unique([portfolioId, symbol])
}

// Every buy and sell, kept as history. Price is the simulated price at the time.
model Trade {
  id           Int       @id @default(autoincrement())
  symbol       String
  side         String    // "BUY" or "SELL"
  quantity     Decimal   @db.Decimal(20, 8)
  price        Decimal   @db.Decimal(20, 8)
  total        Decimal   @db.Decimal(20, 4)
  // Sells only: proceeds minus the average cost of the units sold.
  realizedGain Decimal?  @db.Decimal(20, 4)
  createdAt    DateTime  @default(now())

  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  Int

  @@index([portfolioId, createdAt])
}

// ============================================================================
// Arcade app models. Owned by the Arcade app, see docs/handoff/arcade-app.md.
// ============================================================================

// A user's public identity in the Arcade. Leaderboards show the nickname,
// never the login username.
model ArcadePlayer {
  userId      Int      @id
  nickname    String
  // Lower-case copy of the nickname, so "Nova-42" and "nova-42" can't both exist.
  nicknameKey String   @unique
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Games a user has added to their arcade. `gameId` refers to the game catalog
// (src/apps/arcade/games/catalog.ts). Removing a game keeps its runs.
model ArcadeGame {
  id      Int      @id @default(autoincrement())
  gameId  String
  addedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  @@unique([userId, gameId])
}

// One play of a game. The server picks the seed when the run starts and
// computes the score itself by replaying the input log when it finishes.
model GameRun {
  id         Int       @id @default(autoincrement())
  gameId     String
  seed       Int
  // PLAYING -> FINISHED, or ABANDONED (a newer run started / expired)
  // or REJECTED (the input log didn't replay into a valid game).
  status     String    @default("PLAYING")
  score      Int       @default(0)
  // Game-specific results from the replay, e.g. { lines, level } for Starfall.
  stats      Json?
  // Length of the run in game ticks (60 per second).
  ticks      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int

  @@index([gameId, status, score])
  @@index([userId, gameId, status])
}
